menu "WiFi"

    config WIFI_MANAGER_ENABLED
        bool "Enable the WiFi manager (connect to saved networks at boot)"
        default n
        help
          When disabled the WiFi stack is never started and the API becomes a set of stubs.

    config WIFI_MAX_NETWORKS
        int "Maximum number of saved WiFi networks (1-10)"
        range 1 10
        default 3
        depends on WIFI_MANAGER_ENABLED

endmenu
